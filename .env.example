# Copy this file to .env and fill in your Supabase project's values to
# switch Linkup Sports from local demo mode to a real, shared backend
# that all your friends see live. Without these set, the app still
# works fully — sessions just live only on your own device.
#
# Find these under Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
